# Application
NEXT_PUBLIC_APP_NAME="Bharat Bhoomi-99"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API URL (REQUIRED - no default in production)
API_BASE_URL=http://localhost:5147

# BB Admin Key (REQUIRED - must match BbAdminKey in backend appsettings.json)
BB_ADMIN_KEY=your-admin-key-here

# Session signing secret (REQUIRED - used for admin HMAC session tokens)
NEXTAUTH_SECRET=your-secret-key-min-32-characters

# Google Maps (optional)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Email Service (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@bharatbhoomi99.com

# Blob host for next/image remotePatterns. Must match the backend's
# BLOB_BASE_URL host, or images render blank with a 400.
BLOB_HOST=bbmedia001prd.blob.core.windows.net
